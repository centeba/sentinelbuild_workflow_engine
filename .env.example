# ─── Mit Stack — Environment Variables ────────────────────────────────────────
# Copy this file to .env and fill in values before starting the stack.
# Lines starting with # are comments. Remove the # to enable a variable.
#
# Production checklist:
#   [ ] ENVIRONMENT=production
#   [ ] SECRET_KEY        — random 64-char hex (openssl rand -hex 32)
#   [ ] ENCRYPTION_KEY    — Fernet key (see below)
#   [ ] DATABASE_URL      — points to your production Postgres
#   [ ] REDIS_URL         — points to your production Redis
#   [ ] PUBLIC_BASE_URL   — your public HTTPS domain
#   [ ] CORS_ORIGINS      — your frontend domain(s), comma-separated

# ─── Application ───────────────────────────────────────────────────────────────
ENVIRONMENT=development         # development | production
# APP_NAME=Mit Stack            # displayed in the UI

# ─── Security ──────────────────────────────────────────────────────────────────
# JWT signing secret.  Generate: openssl rand -hex 32
SECRET_KEY=change_me_in_production_use_openssl_rand_hex_32

# Fernet key for encrypting stored credentials at rest.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Leave blank to disable credential encryption (not recommended for production).
ENCRYPTION_KEY=

# Token lifetime (optional — defaults shown)
# ACCESS_TOKEN_EXPIRE_MINUTES=60
# REFRESH_TOKEN_EXPIRE_DAYS=30

# ─── User Master Integration ───────────────────────────────────────────────────
# Set USER_MASTER_SECRET_KEY to the same value as SECRET_KEY in your User Master
# deployment.  When set, Mit Stack will accept JWTs issued by User Master and
# auto-provision the Organisation and User on first request.
#
# Production setup:
#   1. Copy the SECRET_KEY value from User Master's .env here.
#   2. Set STANDALONE_AUTH=false once all users authenticate via User Master.
#      This disables Mit Stack's own /auth/register and /auth/login endpoints.
#
# Leave USER_MASTER_SECRET_KEY blank to run Mit Stack in standalone mode only.
# USER_MASTER_SECRET_KEY=paste_user_master_secret_key_here
# USER_MASTER_ALGORITHM=HS256

# Standalone auth — controls Mit Stack's own /auth/register and /auth/login.
#   true  = endpoints active (default; use during transition or standalone mode)
#   false = endpoints return 501; users must authenticate via User Master
# STANDALONE_AUTH=true

# ─── PostgreSQL ────────────────────────────────────────────────────────────────
# Full async DSN used by the API.
DATABASE_URL=postgresql+asyncpg://mitstack:change_me_in_production@localhost:5432/mitstack

# Variables used by the postgres Docker service (docker-compose.yml).
POSTGRES_DB=mitstack
POSTGRES_USER=mitstack
POSTGRES_PASSWORD=change_me_in_production

# ─── Redis ─────────────────────────────────────────────────────────────────────
# Full DSN used by the API and worker.
REDIS_URL=redis://:change_me_in_production@localhost:6379/0

# Password used by the redis Docker service.
REDIS_PASSWORD=change_me_in_production

# ─── Temporal ──────────────────────────────────────────────────────────────────
TEMPORAL_NAMESPACE=default
# TEMPORAL_HOST=localhost:7233
# TEMPORAL_TASK_QUEUE=mitstack-workflows
# Optional — set only for Temporal Cloud (TLS enables automatically when
# this is set). Leave blank for self-hosted Temporal.
# TEMPORAL_API_KEY=

# ─── URLs ──────────────────────────────────────────────────────────────────────
# Public HTTPS base URL — used in approval email links and OAuth2 redirects.
PUBLIC_BASE_URL=http://localhost:8000

# Comma-separated list of allowed CORS origins (your Flutter web app).
CORS_ORIGINS=http://localhost:3000

# ─── SMTP (approval notification emails) ──────────────────────────────────────
# Leave SMTP_HOST blank to disable email notifications.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=notifications@example.com
# SMTP_PASS=your_smtp_password
# SMTP_FROM=notifications@example.com

# ─── Google OAuth2 (Gmail / Google Drive connectors) ──────────────────────────
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=

# ─── Microsoft OAuth2 (Outlook / OneDrive connectors) ─────────────────────────
# MICROSOFT_OAUTH_CLIENT_ID=
# MICROSOFT_OAUTH_CLIENT_SECRET=

# ─── External AI APIs ─────────────────────────────────────────────────────────
# Enables the AI rule builder (POST /rules/ai-generate) and claude_llm connector.
# ANTHROPIC_API_KEY=

# ─── Rule engine tuning (optional) ────────────────────────────────────────────
# RULE_CACHE_TTL=300            # seconds rules are cached in Redis
# JS_TIMEOUT_MS=2000            # max JS rule execution time (ms)
# WEBHOOK_ACTION_TIMEOUT_SECONDS=10.0  # outbound webhook action timeout (s)

# ─── Pagination (optional) ────────────────────────────────────────────────────
# PAGINATION_DEFAULT_LIMIT=50
# PAGINATION_MAX_LIMIT=500

# ════════════════════════════════════════════════════════════════════════════
# Railway deployment notes
# ════════════════════════════════════════════════════════════════════════════
# The api and worker are TWO separate Railway services built from
# Dockerfile.api / Dockerfile.worker respectively (see
# services/mit-stack/backend/railway.json + railway.worker.json). Both
# Dockerfiles COPY sibling packages (packages/smart-llm,
# packages/sentinelbuild_python_sdk) that live outside
# services/mit-stack/backend/ — set each Railway service's Root Directory
# to the repo root (not services/mit-stack/backend) so the build context
# can reach them.
#
# SECRET_KEY above defaults to a freshly-random value regenerated on every
# process start if left unset (or left as the placeholder above) — this
# WILL break JWT validity across restarts/replicas. Set a real value.
#
# Hard runtime dependency: Temporal (worker/client, no fallback if
# unreachable). Point TEMPORAL_HOST at its private-network address, e.g.
# temporal.railway.internal:7233 (self-hosted), or a Temporal Cloud
# endpoint + TEMPORAL_API_KEY above (TLS enables automatically when the
# key is set). All ~7 scattered Client.connect() call sites in this
# service now route through shared/temporal_client.py, so this is the
# only place the setting needs to be added.
#
# PUBLIC_BASE_URL should be set to the api service's real Railway domain
# once assigned.
